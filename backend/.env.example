# Splunk management API connection
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_VERIFY_SSL=true

# Service account used for /services/auth/login
SPLUNK_USERNAME=svc-log-viewer
SPLUNK_PASSWORD=change-me

# Field name that holds the log level/severity in your events.
# Some environments use "level", "severity", "log_level", etc.
SPLUNK_LEVEL_FIELD=log_level

# Comma-separated list of indexes to offer by default in the UI
SPLUNK_DEFAULT_INDEXES=1003865

# Network timeouts (seconds)
SPLUNK_CONNECT_TIMEOUT=5
SPLUNK_READ_TIMEOUT=30

# CORS: origin the frontend dev server runs on
FRONTEND_ORIGIN=http://localhost:5173
